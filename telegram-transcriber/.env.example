TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=your_telegram_user_id_here
LANGUAGE=ru
WHISPER_MODEL=small
# On Apple Silicon Mac leave as cpu (faster-whisper uses CPU reliably)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Large files (forwarded mp3/video > 20 MB) ---
# 1) Get api_id + api_hash: https://my.telegram.org → API development tools
# 2) Run: ./start_local_api.sh
# 3) Keep these lines:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_API_URL=http://127.0.0.1:8081
# Max seconds to download a large video through the bot (default 30 min)
DOWNLOAD_TIMEOUT_SEC=1800
